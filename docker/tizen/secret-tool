#!/bin/bash
# Substitui o `secret-tool` que o CLI do Tizen usa no Linux para guardar a senha do certificado:
# o original precisa de um chaveiro (D-Bus) que o container não tem, e sem ele a senha some e o
# `tizen package` falha com "Invaild password". Aqui a senha fica num arquivo do volume tizen-data,
# ao lado do .p12, com permissão 600; o volume nunca vai para o repositório.
#
# O Tizen chama:
#   secret-tool store  --label="tizen-studio" -p <senha> keyfile <caminho.pwd> tool certificate-manager
#   secret-tool lookup --label="tizen-studio" keyfile <caminho.pwd> tool certificate-manager
set -eu

DIR=/home/dev/tizen-studio-data/secrets
mkdir -p "$DIR"
chmod 700 "$DIR"

cmd=${1:-}
shift || true

pass=
key=
while [ $# -gt 0 ]; do
    case "$1" in
        --label*) shift ;;
        -p) pass=${2-}; shift 2 ;;
        keyfile) key=${2-}; shift 2 ;;
        *) shift 2 || shift ;;
    esac
done
file="$DIR/$(printf '%s' "$key" | tr -c 'A-Za-z0-9._-' '_')"

case "$cmd" in
    store)
        # O Tizen também grava senha vazia (em paralelo, para o distribuidor): não sobrescreve a boa.
        [ -n "$pass" ] || exit 0
        umask 077
        printf '%s' "$pass" > "$file"
        ;;
    lookup)
        [ -s "$file" ] || exit 1
        cat "$file"
        ;;
    clear)
        rm -f "$file"
        ;;
    *)
        echo "secret-tool (shim do container): comando não suportado: $cmd" >&2
        exit 2
        ;;
esac
